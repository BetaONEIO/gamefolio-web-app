SESSION_SECRET=z+lxBsRNyONsE+zieYeHlVTCUDdxGJDgKyoV1N+4pwM=

# Email Service Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key_here

# Custom Domain Configuration (for share links)
# Set this to your custom domain when deploying (e.g., beta.gamefolio.com)
CUSTOM_DOMAIN=

# Video Ad Tag (VAST/VPAID URL from Google Ad Manager or another video SSP).
# Leave empty to disable video preroll ads on clips/reels entirely.
# When empty, the IMA SDK is never loaded and the ad slot is skipped.
VITE_AD_TAG_URL=

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456).
# Leave empty to skip loading adsbygoogle.js entirely.
VITE_ADSENSE_CLIENT_ID=

# Sentry crash/error reporting (Capacitor + WebView).
# Leave VITE_SENTRY_DSN empty to disable Sentry entirely (no-op). Set it to the
# DSN from your Sentry project (Settings → Client Keys) to turn capture on.
VITE_SENTRY_DSN=
# Optional override for the Sentry environment tag (defaults to
# production/development based on the build mode).
VITE_SENTRY_ENVIRONMENT=
# Sentry only reports from the "production" environment. Dev workspaces and the
# beta Replit project share this DSN and the org's single monthly error quota,
# so a broken non-prod build must not be able to exhaust it and blind
# production. Set to "true" to opt a non-prod environment back in deliberately
# (give it its own DSN/project if you do). Server-side equivalent below.
VITE_SENTRY_ALLOW_NON_PRODUCTION=
# Optional: only needed to upload sourcemaps so minified stack traces become
# readable. When SENTRY_AUTH_TOKEN is set, `vite build` uploads maps for the
# release and deletes them afterwards. Org/project are the Sentry slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Server-side (Express) crash/error reporting. Falls back to VITE_SENTRY_DSN
# if unset — same DSN, events land in the same project, distinguished by the
# `runtime: server` tag. Leave both empty to disable server-side Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Server-side counterpart to VITE_SENTRY_ALLOW_NON_PRODUCTION (see above).
SENTRY_ALLOW_NON_PRODUCTION=
# Streamer Partner sync — pushes Gamefolio Pro partners to the gamefolio.com
# marketing site's /streamers directory. Leave either var empty to disable
# the sync entirely (partner status still works in-app, just not mirrored).
# PARTNER_SYNC_SECRET must match the same var in the marketing (gamefolio) repo.
MARKETING_API_URL=
PARTNER_SYNC_SECRET=

# AI VOD-clip generation (POC — server/services/ai-vod-clip-jobs.ts).
# Also needs TWITCH_CLIENT_ID/TWITCH_CLIENT_SECRET (see server/services/twitch-api.ts)
# for VOD listing/download — not duplicated here as those are pre-existing.
# Anthropic API key used for highlight selection (Claude reads the transcript).
ANTHROPIC_API_KEY=
# Local Whisper model (transformers.js/ONNX) used for transcription. Defaults
# to Xenova/whisper-base.en if unset.
AI_VOD_WHISPER_MODEL=
# Optional override for the Claude model used to pick highlight windows.
# Defaults to claude-haiku-4-5-20251001.
AI_VOD_CLAUDE_MODEL=
# Hard cap on VOD length for Pro users, in seconds. Defaults to 2700 (45 min)
# — CPU-only local Whisper transcription is slow, so longer VODs are
# rejected at job-creation time rather than left to run indefinitely.
AI_VOD_MAX_VOD_DURATION_SECONDS=
# Same cap for free users. Defaults to 1200 (20 min).
AI_VOD_FREE_MAX_VOD_DURATION_SECONDS=
# Daily job-creation limits, free vs Pro (resets at UTC midnight). Defaults:
# free=1, pro=3. This pipeline is compute/API-cost heavy per job, so both
# tiers are capped, not just free.
AI_VOD_FREE_DAILY_JOBS=
AI_VOD_PRO_DAILY_JOBS=
